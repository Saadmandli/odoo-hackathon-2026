# Database (PostgreSQL)
DATABASE_URL="postgresql://vendorbridge:vendorbridge@localhost:5432/vendorbridge?schema=public"

# Auth - generate a long random string
JWT_SECRET="change-this-to-a-long-random-secret-string-at-least-32-chars"

# SMTP for sending invoices via email (optional - falls back to console log if unset)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="VendorBridge <your-email@gmail.com>"
